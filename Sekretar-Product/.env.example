# Public URLs
PUBLIC_BASE_URL=https://aisekretar.ru
PRODUCT_API_PUBLIC_URL=https://aisekretar.ru/api
WEB_APP_PUBLIC_URL=https://aisekretar.ru

# Internal service URLs
PRODUCT_API_INTERNAL_URL=http://product-api:8000
AI_PROCESSING_INTERNAL_URL=http://ai-processing:8000
WORKER_INTERNAL_URL=http://worker:8000
EXTERNAL_LLM_GATEWAY_INTERNAL_URL=http://external-llm-gateway:8000

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sekretar
POSTGRES_USER=sekretar
POSTGRES_PASSWORD=change-me
POSTGRES_SSLMODE=prefer

# Queue
QUEUE_URL=redis://localhost:6379/0

# Storage
STORAGE_ROOT=/var/lib/sekretar/storage
RAW_AUDIO_STORAGE_PATH=/var/lib/sekretar/storage/raw-audio
UPLOAD_CHUNKS_STORAGE_PATH=/var/lib/sekretar/storage/upload-chunks
ARTIFACTS_STORAGE_PATH=/var/lib/sekretar/storage/artifacts
EXPORTS_STORAGE_PATH=/var/lib/sekretar/storage/exports

# Local AI
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda
LOCAL_LLM_PROVIDER=ollama
LOCAL_LLM_MODEL=llama3
LOCAL_LLM_BASE_URL=http://localhost:11434

# External LLM
EXTERNAL_LLM_PROVIDER=
EXTERNAL_LLM_API_KEY=
EXTERNAL_LLM_MODEL=

# Integrations
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://aisekretar.ru/oauth2callback

# Security
APP_SECRET_KEY=change-me
ACCESS_TOKEN_TTL_MINUTES=60
RATE_LIMIT_DEFAULT_PER_MINUTE=60
TRUST_SCORE_DEFAULT=50

# Billing
BILLING_MODE=virtual
BETA_STARTING_CREDITS=20
FREE_TRIAL_DAYS=14

# Runtime
ENVIRONMENT=local
LOG_LEVEL=INFO
